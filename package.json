{
  "name": "hyperodds-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/client",
    "packages/ai-sdk",
    "packages/langchain",
    "packages/openai-agents"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test \"packages/*/test/*.test.js\"",
    "demo": "npm run build && node scripts/demo.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.106",
    "@biomejs/biome": "2.6.2",
    "@langchain/core": "1.3.2",
    "@langchain/openai": "1.8.0",
    "@openai/agents": "0.21.0",
    "@types/node": "22.20.5",
    "ai": "7.0.159",
    "langchain": "1.6.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
