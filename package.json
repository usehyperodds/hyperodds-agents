{
  "name": "hyperodds-agents",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/client",
    "packages/ai-sdk",
    "packages/langchain",
    "packages/openai-agents"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "build:n8n": "npm --prefix packages/n8n-nodes-hyperodds run build",
    "typecheck": "npm run build && tsc -p tsconfig.json && npm --prefix packages/n8n-nodes-hyperodds run typecheck",
    "lint": "biome check . && npm --prefix packages/n8n-nodes-hyperodds run lint",
    "format": "biome check --write .",
    "test": "npm run build && npm run build:n8n && node --test \"packages/*/test/*.test.js\"",
    "demo": "npm run build && node scripts/demo.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.121",
    "@biomejs/biome": "2.6.2",
    "@langchain/core": "1.4.2",
    "@langchain/openai": "1.8.4",
    "@openai/agents": "0.22.0",
    "@types/node": "22.20.5",
    "ai": "7.0.177",
    "langchain": "1.6.7",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
