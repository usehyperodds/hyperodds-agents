    "hyperodds",
    "hyperliquid",
    "hip-4",
    "outcome-markets",
    "prediction-markets",
    "langchain",
    "langchainjs",
    "langgraph",
    "ai-agents",
    "tools"
  ],
  "homepage": "https://github.com/usehyperodds/hyperodds-agents/tree/main/packages/langchain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usehyperodds/hyperodds-agents.git",
    "directory": "packages/langchain"
  },
  "bugs": {
    "url": "https://github.com/usehyperodds/hyperodds-agents/issues"
  },
  "license": "MIT",
  "author": "Hyperodds <dev@usehyperodds.com> (https://usehyperodds.com)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
